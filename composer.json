{
    "name": "szepeviktor/consistent-versions",
    "description": "Check that version values in different file formats are consistent",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "version",
        "consistency",
        "jsonpath",
        "wordpress"
    ],
    "autoload": {
        "psr-4": {
            "SzepeViktor\\ConsistentVersions\\": "src/"
        }
    },
    "bin": [
        "bin/consistent-versions"
    ],
    "authors": [
        {
            "name": "Viktor Szépe",
            "email": "viktor@szepe.net"
        }
    ],
    "require": {
        "php": "^8.1",
        "composer/semver": "^3.4",
        "nette/neon": "^3.4",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "@php tests/run.php",
        "lint": "@php tools/lint.php",
        "phpstan": "@php vendor/bin/phpstan analyse --debug --no-progress --error-format=raw",
        "versions": "@php bin/consistent-versions check tests/consistent-versions.yaml",
        "all": [
            "@lint",
            "@phpstan",
            "@test",
            "@versions"
        ]
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
